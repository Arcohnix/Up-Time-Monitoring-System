{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System Overview & Availability",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Monitored Services (Enabled)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(utms_monitored_services_total{status=\"enabled\"}) or vector(0)",
          "legendFormat": "Enabled Services",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Incidents",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "utms_active_incidents_total or vector(0)",
          "legendFormat": "Active Outages",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Monitoring Worker Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "STOPPED", "color": "red" },
                "1": { "text": "RUNNING", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "utms_scheduler_running or vector(0)",
          "legendFormat": "Scheduler State",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Check Success Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(utms_checks_success_total[5m])) / sum(rate(utms_checks_total[5m])) * 100) or vector(100)",
          "legendFormat": "Success %",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "Check Performance & Success / Failure Rates",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Check Throughput (Checks / sec)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15, "lineInterpolation": "smooth" },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(utms_checks_total[1m])) by (status)",
          "legendFormat": "Status: {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Failures by Error Type",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(utms_checks_failed_total[1m])) by (error_type)",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 300,
      "title": "Probe Response Time & Latency",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Check Latency Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineInterpolation": "smooth" },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(utms_check_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50 (Median)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(utms_check_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(utms_check_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "title": "Average Check Latency by Service",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(utms_check_duration_seconds_sum[1m])) by (service_name) / sum(rate(utms_check_duration_seconds_count[1m])) by (service_name)",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 400,
      "title": "Active Incidents & Alerts",
      "type": "row"
    },
    {
      "id": 9,
      "title": "Incident Transitions (Created vs Recovered)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(utms_incidents_created_total[1m]))",
          "legendFormat": "Incidents Opened / sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate(utms_incidents_recovered_total[1m]))",
          "legendFormat": "Incidents Recovered / sec",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "Alert Notifications (Sent vs Failed)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(utms_notifications_sent_total[1m])) by (provider)",
          "legendFormat": "{{provider}} Sent",
          "refId": "A"
        },
        {
          "expr": "sum(rate(utms_notification_failures_total[1m])) by (provider)",
          "legendFormat": "{{provider}} Failed",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 500,
      "title": "Monitoring Worker & API Health",
      "type": "row"
    },
    {
      "id": 11,
      "title": "Scheduler Ticks & In-Flight Checks",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "rate(utms_scheduler_ticks_total[1m])",
          "legendFormat": "Ticks / sec",
          "refId": "A"
        },
        {
          "expr": "utms_scheduler_in_flight_checks",
          "legendFormat": "In-Flight Probes",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "title": "API Request Throughput by Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15 },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(utms_api_requests_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["utms", "observability", "uptime", "sre"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "UTMS — Monitoring & System Observability",
  "uid": "utms-system-observability",
  "version": 1
}
