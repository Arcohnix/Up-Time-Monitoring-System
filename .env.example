# Application Settings
PROJECT_NAME="Uptime Monitoring System"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="utms"

# Optional: Override with explicit full database URL
# Async PostgreSQL URL format:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/utms"

# Monitoring Scheduler
ENABLE_SCHEDULER=true
SCHEDULER_TICK_INTERVAL_SECONDS=1.0
SCHEDULER_MAX_CONCURRENCY=50

# Alerting & Notification Settings
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL="https://example.com/alerts/webhook"
ALERT_WEBHOOK_TIMEOUT_SECONDS=10.0

ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST="smtp.example.com"
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_USER="smtp_user"
ALERT_EMAIL_SMTP_PASSWORD="smtp_password"
ALERT_EMAIL_USE_TLS=true
ALERT_EMAIL_FROM="alerts@utms.local"
ALERT_EMAIL_TO="admin@example.com"

# Observability (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"

